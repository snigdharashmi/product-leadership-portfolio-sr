{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalised PMO Ticket",
  "type": "object",
  "required": ["ticket_id", "client_id", "source_id", "summary", "status", "priority"],
  "properties": {
    "ticket_id": { "type": "string", "description": "Internal normalised ID" },
    "client_id": { "type": "string" },
    "project_id": { "type": "string" },
    "source_system": { "type": "string", "enum": ["Jira", "AzureDevOps"] },
    "source_id": { "type": "string", "description": "Original key e.g. CLIENT1-123" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string" },
    "priority": { "type": "string", "enum": ["Highest", "High", "Medium", "Low", "Lowest"] },
    "severity": { "type": "string" },
    "issue_type": { "type": "string" },
    "assignee": { "type": "string" },
    "reporter": { "type": "string" },
    "estimate_hours": { "type": "number" },
    "actual_hours": { "type": "number" },
    "fix_version": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "linked_tickets": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string" },
    "classification": { "type": "string", "enum": ["internal", "client-confidential", "restricted"] }
  }
}
